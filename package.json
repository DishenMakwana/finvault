{
  "name": "finvault",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "format": "bun node_modules/prettier/bin/prettier.cjs --write \"src/**/*.{ts,tsx}\"",
    "prisma:generate": "bun node_modules/prisma/build/index.js generate",
    "prisma:migrate": "bun node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:prod": "bun node_modules/prisma/build/index.js migrate deploy",
    "prisma:create": "bun node_modules/prisma/build/index.js migrate dev --create-only",
    "prisma:studio": "bun node_modules/prisma/build/index.js studio",
    "prisma:seed": "bun prisma/seeds/seed.ts",
    "prisma:status": "bun node_modules/prisma/build/index.js migrate status"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.4.7",
    "geist": "^1.8.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "next": "16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "ua-parser-js": "2.0.10",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "knip": "^6.46.1",
    "postcss": "^8.5.2",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
