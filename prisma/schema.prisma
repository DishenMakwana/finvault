datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  sessions        Session[]
  houses          House[]
  transactions    Transaction[]
  loans           Loan[]
  rentalVacancies RentalVacancy[]

  @@map("users")
}

model Session {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  token           String    @unique
  userAgent       String?   @map("user_agent")
  ipAddress       String?   @map("ip_address")

  // Parsed Device, Browser & OS Metadata
  browserName     String?   @map("browser_name")
  browserVersion  String?   @map("browser_version")
  osName          String?   @map("os_name")
  osVersion       String?   @map("os_version")
  deviceType      String?   @map("device_type")
  deviceVendor    String?   @map("device_vendor")
  deviceModel     String?   @map("device_model")
  cpuArchitecture String?   @map("cpu_architecture")

  expiresAt       DateTime  @map("expires_at")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model House {
  id              Int             @id @default(autoincrement())
  userId          Int             @map("user_id")
  name            String
  address         String?
  initialCash     Decimal         @default(0) @db.Decimal(12, 2)
  initialCashDate DateTime        @default(now()) @map("initial_cash_date")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?       @map("deletedat")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  loans           Loan[]
  repayments      LoanRepayment[]

  @@index([userId, deletedAt])
  @@index([deletedAt, createdAt(sort: Asc)])
  @@map("houses")
}

enum TransactionType {
  INFLOW
  OUTFLOW
}

model Transaction {
  id        Int             @id @default(autoincrement())
  userId    Int             @map("user_id")
  houseId   Int             @map("house_id")
  type      TransactionType
  amount    Decimal         @db.Decimal(12, 2)
  title     String
  desc      String?
  category  String
  dateOfAdd DateTime        @default(now()) @map("date_of_add")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?       @map("deletedat")
  isFlagged Boolean         @default(false) @map("is_flagged")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  house     House           @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt, dateOfAdd])
  @@index([houseId, deletedAt, dateOfAdd])
  @@index([userId, houseId, type, deletedAt])
  @@index([category, deletedAt])
  @@index([dateOfAdd])
  @@index([deletedAt])
  @@index([userId, isFlagged, deletedAt])
  @@index([deletedAt, dateOfAdd(sort: Desc)])
  @@index([deletedAt, type, dateOfAdd(sort: Desc)])
  @@index([deletedAt, type, category, amount])
  @@index([houseId, deletedAt, type, dateOfAdd(sort: Desc)])
  @@map("transactions")
}

enum LoanStatus {
  PENDING
  PARTIALLY_PAID
  FULLY_PAID
}

model Loan {
  id                 Int             @id @default(autoincrement())
  userId             Int             @map("user_id")
  houseId            Int?            @map("house_id")
  relativeName       String          @map("relative_name")
  totalAmount        Decimal         @db.Decimal(12, 2) @map("total_amount")
  amountPaid         Decimal         @default(0) @db.Decimal(12, 2) @map("amount_paid")
  nextPaymentDueDate DateTime?       @map("next_payment_due_date")
  status             LoanStatus      @default(PENDING)
  notes              String?
  loanDate           DateTime        @default(now()) @map("loan_date")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?       @map("deletedat")

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  house              House?          @relation(fields: [houseId], references: [id], onDelete: SetNull)
  repayments         LoanRepayment[]

  @@index([userId, deletedAt, status])
  @@index([houseId, deletedAt])
  @@index([relativeName])
  @@index([status])
  @@index([nextPaymentDueDate])
  @@index([deletedAt])
  @@index([deletedAt, totalAmount(sort: Desc), createdAt(sort: Desc)])
  @@map("loans")
}

model LoanRepayment {
  id            Int       @id @default(autoincrement())
  loanId        Int       @map("loan_id")
  houseId       Int?      @map("house_id")
  amount        Decimal   @db.Decimal(12, 2)
  repaymentDate DateTime  @default(now()) @map("repayment_date")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  loan          Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  house         House?    @relation(fields: [houseId], references: [id], onDelete: SetNull)

  @@index([loanId, repaymentDate])
  @@index([houseId, repaymentDate])
  @@map("loan_repayments")
}

model RentalVacancy {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  unitName  String   @map("unit_name")
  year      Int
  month     Int
  isVacant  Boolean  @default(true) @map("is_vacant")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, unitName, year, month])
  @@index([userId, year])
  @@map("rental_vacancies")
}
